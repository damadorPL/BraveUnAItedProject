# =============================================================================
# Baza Porad – Fundacja SYNAPSIS (UnAIted)
# Environment Variables Configuration Template
# =============================================================================

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication
# IMPORTANT: Change this secret in production!
JWT_SECRET=your-secure-jwt-secret-key-here

# Database Configuration
# Supported engines: 'sqlite' | 'postgres'
DATABASE_ENGINE=sqlite

# SQLite Settings (used when DATABASE_ENGINE=sqlite)
SQLITE_PATH=./data/synapsis.sqlite

# PostgreSQL Settings (used when DATABASE_ENGINE=postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/synapsis_db
